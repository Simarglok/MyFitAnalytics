{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyFitAnalytics",
  "version": "0.1.0",
  "identifier": "com.simarglok.myfitanalytics",
  "build": {
    "beforeDevCommand": "pnpm --dir web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/build-module-packages.sh && pnpm --dir web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyFitAnalytics",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../dist/modules/mynetdiary.mfasource": "modules/mynetdiary.mfasource",
      "../dist/modules/hevy.mfasource": "modules/hevy.mfasource"
    }
  }
}
