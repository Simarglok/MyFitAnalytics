{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myfitanalytics.local/schemas/dashboard-manifest.schema.json",
  "title": "MyFitAnalytics dashboard module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_type",
    "module_id",
    "module_version",
    "package_format_version",
    "dashboard_api_version",
    "entrypoint_hash",
    "compatible_app_versions",
    "required_capabilities",
    "required_extension_contracts",
    "localization_namespace"
  ],
  "properties": {
    "module_type": { "const": "dashboard" },
    "module_id": { "$ref": "#/$defs/id" },
    "module_version": { "$ref": "#/$defs/version" },
    "package_format_version": { "$ref": "#/$defs/version" },
    "dashboard_api_version": { "$ref": "#/$defs/version" },
    "entrypoint_hash": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]+$" },
    "compatible_app_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "extension": { "$ref": "#/$defs/extension" }
        }
      }
    },
    "required_extension_contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/extension" }
    },
    "localization_namespace": { "$ref": "#/$defs/namespace" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "contract_version"],
      "properties": {
        "namespace": { "$ref": "#/$defs/namespace" },
        "contract_version": { "$ref": "#/$defs/version" }
      }
    }
  }
}
