{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myfitanalytics.local/schemas/locale-manifest.schema.json",
  "title": "MyFitAnalytics data-only locale module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_type",
    "module_id",
    "locale",
    "display_name",
    "module_version",
    "package_format_version",
    "compatible_app_versions",
    "localization_namespace",
    "files"
  ],
  "properties": {
    "module_type": { "const": "locale" },
    "module_id": { "$ref": "#/$defs/id" },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$" },
    "display_name": { "type": "string", "minLength": 1 },
    "module_version": { "$ref": "#/$defs/version" },
    "package_format_version": { "$ref": "#/$defs/version" },
    "compatible_app_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "localization_namespace": { "$ref": "#/$defs/namespace" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "executable"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]+$" },
          "executable": { "const": false }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}
